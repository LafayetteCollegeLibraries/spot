<% members = presenter.member_presenters %>

<div class="card">
  <div class="card-header">
    <h5>Contains</h5>
  </div>
  <table class="table table-sm table-bordered metadata-table">
    <tbody>
    <% members.each do |member| %>
      <% model_name = member.model_name.singular.to_sym %>
      <% type = %i[file_set file].include?(model_name) ? 'File' : 'Work' %>
      <% type_class = type == 'File' ? 'default' : 'primary' %>
      <tr>
        <td class="text-center">
          <span class="label label-<%= type_class %>"><%= type %></span>
          <% if type == 'File' && member.transcript_name != nil %>
            <br>
            <span class="label label-<%= type_class %>">Captioned</span>
          <% end %>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
</div>
