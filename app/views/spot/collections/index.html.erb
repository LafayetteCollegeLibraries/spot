<% provide(:page_title) { t('.page_title', name: application_name) } %>

<div class="page-header">
  <h1><%= t('.header') %></h1>
</div>

<div class="panel-group" id="accordion" role="tablist" aria-multiselectable="true">
  <div class="panel panel-default">
    <div class="panel-heading" role="tab" id="headingOne">
      <h4 class="panel-title">
        <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
          Lafayette Scholarship
        </a>
      </h4>
    </div>
    <div id="collapseOne" class="panel-collapse collapse card" role="tabpanel" aria-labelledby="headingOne">
      <ul class="list-group list-group-flush">
        <li class="list-group-item"><%= link_to 'Faculty Publications', hyrax.collection_path(id: 'faculty-publications') %></li>
        <li class="list-group-item"><%= link_to 'Student Honors Theses', hyrax.collection_path(id: 'honors-theses') %></li>
      </ul>
    </div>
  </div>
  <div class="panel panel-default">
    <div class="panel-heading" role="tab" id="headingTwo">
      <h4 class="panel-title">
        <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
          Lafayette College Archives
        </a>
      </h4>
    </div>
    <div id="collapseTwo" class="panel-collapse collapse card" role="tabpanel" aria-labelledby="headingTwo">
      <ul class="list-group list-group-flush">
        <li class="list-group-item"><%= link_to 'College Administration', hyrax.collection_path(id: 'college-administration') %></li>
        <li class="list-group-item"><%= link_to 'College Archives Image Collection', hyrax.collection_path(id: 'historical-photos') %></li>
        <li class="list-group-item"><%= link_to 'Commencement Programs', hyrax.collection_path(id: 'commencement-programs') %></li>
        <li class="list-group-item"><%= link_to "General Eisenhower at Lafayette: Founders' Day 1946", hyrax.collection_path(id: 'eisenhower') %></li>
        <li class="list-group-item"><%= link_to 'Lafayette College World War II Casualties', hyrax.collection_path(id: 'war-casualties') %></li>
        <li class="list-group-item"><%= link_to 'Lafayette Magazine archive', hyrax.collection_path(id: 'lafayette-magazine-archive') %></li>
        <li class="list-group-item"><%= link_to 'Lafayette Newspaper archive', hyrax.collection_path(id: 'lafayette-newspaper-archive') %></li>
        <li class="list-group-item"><%= link_to 'Library Newsletters', hyrax.collection_path(id: 'library-newsletters') %></li>
        <li class="list-group-item"><%= link_to 'McKelvy House', hyrax.collection_path(id: 'mckelvy-house') %></li>
        <li class="list-group-item"><%= link_to 'Public Safety', hyrax.collection_path(id: 'public-safety') %></li>
        <li class="list-group-item"><%= link_to 'Student Publications', hyrax.collection_path(id: 'student-publications') %></li>
      </ul>
    </div>
  </div>
  <div class="panel panel-default">
    <div class="panel-heading" role="tab" id="headingThree">
      <h4 class="panel-title">
        <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
          Special Collections
        </a>
      </h4>
    </div>
    <div id="collapseThree" class="panel-collapse collapse card" role="tabpanel" aria-labelledby="headingThree">
      <ul class="list-group list-group-flush">
        <li class="list-group-item"><%= link_to 'Alsace-Lorraine Picture Postcard Collection', hyrax.collection_path(id: 'alsace-images') %></li>
        <li class="list-group-item"><%= link_to 'Gazette of the American Friends of Lafayette', hyrax.collection_path(id: 'gazette-american-friends-lafayette') %></li>
        <li class="list-group-item"><%= link_to 'Hubbard Collection of Letters from the Marquis de Lafayette to George Washington', hyrax.collection_path(id: 'mdl-letters') %></li>
        <li class="list-group-item"><%= link_to 'Marquis de Lafayette Prints Collection', hyrax.collection_path(id: 'mdl-prints') %></li>
        <li class="list-group-item"><%= link_to 'Shakespeare Bulletin Archive', hyrax.collection_path(id: 'shakespeare-bulletin-archive') %></li>
      </ul>
    </div>
  </div>
  <div class="panel panel-default">
    <div class="panel-heading" role="tab" id="headingFour">
      <h4 class="panel-title">
        <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseFour" aria-expanded="false" aria-controls="collapseFour">
          East Asia Image Collection
        </a>
      </h4>
    </div>
    <div id="collapseFour" class="panel-collapse collapse" role="tabpanel" aria-labelledby="headingFour">
      <div class="container-fluid" style="margin-top: 1rem;">
        <div class="row">
          <div class="col-sm-6">
            <ul class="list-group list-group-flush">
              <li class="list-group-item"><%= link_to 'Gerald and Rella Warner Dutch East Indies Negatives', hyrax.collection_path(id: 'warner-negs-indonesia') %></li>
              <li class="list-group-item"><%= link_to 'Gerald and Rella Warner Japan Slides', hyrax.collection_path(id: 'warner-slides-japan') %></li>
              <li class="list-group-item"><%= link_to 'Gerald and Rella Warner Manchuria Negatives', hyrax.collection_path(id: 'warner-negs-manchuria') %></li>
              <li class="list-group-item"><%= link_to 'Gerald and Rella Warner Postcards', hyrax.collection_path(id: 'warner-postcards') %></li>
              <li class="list-group-item"><%= link_to 'Gerald and Rella Warner Souvenirs of Beijing and Tokyo', hyrax.collection_path(id: 'warner-souvenirs') %></li>
              <li class="list-group-item"><%= link_to 'Gerald and Rella Warner Taiwan Negatives', hyrax.collection_path(id: 'warner-negs-taiwan') %></li>
              <li class="list-group-item"><%= link_to 'Imperial Postcards', hyrax.collection_path(id: 'imperial-postcards') %></li>
              <li class="list-group-item"><%= link_to 'Japanese History Study Cards', hyrax.collection_path(id: 'gc-iroha01') %></li>
              <li class="list-group-item"><%= link_to 'Japanese Imperial House Postcard Album', hyrax.collection_path(id: 'pa-koshitsu') %></li>
              <li class="list-group-item"><%= link_to 'Lin Chia-Feng Family Postcards', hyrax.collection_path(id: 'lin-postcards') %></li>
              <li class="list-group-item"><%= link_to 'Michael Lewis Postcards', hyrax.collection_path(id: 'lewis-postcards') %></li>
            </ul>
          </div>
          <div class="col-sm-6">
            <ul class="list-group list-group-flush">
              <li class="list-group-item"><%= link_to 'Pacific War Postcards', hyrax.collection_path(id: 'pacwar-postcards') %></li>
              <li class="list-group-item"><%= link_to 'Richard Mammana Japanese Empire Postcard Collection', hyrax.collection_path(id: 'mammana-postcards') %></li>
              <li class="list-group-item"><%= link_to 'Scenic Taiwan Book', hyrax.collection_path(id: 'cpw-nofuko') %></li>
              <li class="list-group-item"><%= link_to 'Sino-Japanese War Postcard Album 01', hyrax.collection_path(id: 'pa-omitsu01') %></li>
              <li class="list-group-item"><%= link_to 'Sino-Japanese War Postcard Album 02', hyrax.collection_path(id: 'pa-omitsu02') %></li>
              <li class="list-group-item"><%= link_to 'Sven Saaler Postcards of Japanese Bronze Statues', hyrax.collection_path(id: 'japan-bronzes') %></li>
              <li class="list-group-item"><%= link_to 'T.W. Ingersoll Co. Stereoviews of the Siege of Port Arthur', hyrax.collection_path(id: 'rjw-stereo') %></li>
              <li class="list-group-item"><%= link_to 'Taiwan Photographic Monthly Periodical', hyrax.collection_path(id: 'cpw-shashinkai') %></li>
              <li class="list-group-item"><%= link_to 'The Truku-Japanese War Commemorative Postcard Collection', hyrax.collection_path(id: 'tjwar-postcards') %></li>
              <li class="list-group-item"><%= link_to 'Tsubokura Russo-Japanese War Postcard Album', hyrax.collection_path(id: 'pa-tsubokura') %></li>
              <li class="list-group-item"><%= link_to 'Woodsworth Images', hyrax.collection_path(id: 'woodsworth-images') %></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="panel panel-default">
    <div class="panel-heading" role="tab" id="headingFive">
      <h4 class="panel-title">
        <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseFive" aria-expanded="false" aria-controls="collapseFive">
          Academic Partnership Collections
        </a>
      </h4>
    </div>
    <div id="collapseFive" class="panel-collapse collapse card" role="tabpanel" aria-labelledby="headingFive">
      <ul class="list-group list-group-flush">
        <li class="list-group-item"><%= link_to 'Deep Time Maps', hyrax.collection_path(id: 'time-slice-maps') %> <span class="label label-info">Lafayette College</span></li>
        <li class="list-group-item"><%= link_to 'John S. Shelton Earth Science Image Collection', hyrax.collection_path(id: 'geology-slides-esi') %> <span class="label label-info">Lafayette College</span></a></li>
      </ul>
    </div>
  </div>
</div>

<%= render partial: 'catalog/paginate_compact', object: @response %>

<% @collections.each_slice(3).each do |collections| %>
<div class="row">
  <% collections.each do |collection| %>
    <%= render 'collection_list_item', collection: collection %>
  <% end %>
</div>
<% end %>

<div class="row record-padding">
  <div class="col-md-12">
    <div class="pagination">
      <%= paginate @response, outer_window: 2, theme: 'blacklight' %>
    </div>
  </div>
</div>
