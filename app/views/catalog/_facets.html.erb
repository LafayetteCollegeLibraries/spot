<%# container for facet groups
  # we need to add a condition to hide admin facets from non-admin users
  #
  # @overrides https://github.com/projectblacklight/blacklight/blob/v7.38.0/app/views/catalog/_facets.html.erb
-%>
<% Deprecation.silence(Blacklight::Facet) { facet_group_names }.each do |groupname| %>
  <% next if groupname == :admin && !current_user&.admin? %>
  <%= render 'facet_group', groupname: groupname %>
<% end %>