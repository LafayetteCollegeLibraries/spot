<% model = document.hydra_model %>
<div class="search-results-title-row col-12 d-flex flex-row align-items-center pb-2">
  <% if model == Hyrax::PcdmCollection || model < Hyrax::PcdmCollection %>
    <h4 class="search-result-title"><%= link_to document.title_or_label, [hyrax, document] %></h4>
    <%= Hyrax::CollectionPresenter.new(document, current_ability).collection_type_badge %>
  <% else %>
    <h4 class="search-result-title"><%= link_to document.title_or_label, document %></h4>
  <% end %>

  <% if display_info_alert?(document) %>
    <div class="alert alert-warning" style="margin:0; padding:5px;">
      <%= document_access_display_text(document) %>
    </div>
  <% end %>
</div>
