##
# Environment variables required to get Spot up and running.
# These values are shared among the Rails, Sidekiq, and db_migrate
# services and are mostly links between the Docker Compose services
# Hyrax uses (eg. Fedora, Solr, Redis, S3).
#
# Some environment variables contain sensitive information we'd rather
# not commit to the repository. These can be specified in a local
# `development.local.env` file, which is not tracked in the Git repository.
# (see `development.local.env.sample` for examples). Spot's Docker Compose
# environment will prioritize these values if the file is present.
#
# To provide Sidekiq-specific environment overrides, a local
# `development.local.sidekiq.env` file, also not tracked by Git,
# will be used. In the Sidekiq service, this file's values
# will be prioritized over the local overrides, which are prioritized
# over these default values.
##

# 'localhost' will get Spot up and running, but this needs to be the
# hostname of a supported Lafayette service for CAS authentication to work.
# Add the value to the untracked `development.local.env` file instead.
APPLICATION_FQDN="localhost"

# S3-specific values. In development, S3 services are mimicked using
# a local MinIO instance. AWS_IIIF_ASSET_BUCKET and AWS_BULKRAX_IMPORTS_BUCKET
# are created (if absent) as part of the development entrypoint.
AWS_ACCESS_KEY_ID=minio_root_user
AWS_SECRET_ACCESS_KEY=minio_root_password
AWS_REGION=us-east-1
AWS_ENDPOINT_URL="http://minio:9000"
AWS_IIIF_ASSET_BUCKET=iiif-derivatives
AWS_BULKRAX_IMPORTS_BUCKET=ldr-imports

# Note: these may be relics that may no longer be needed. Database config values
#       are handled through the PSQL_* variables.
DATABASE_URL="postgres://spot_dev_user:spot_dev_pw@db/spot_dev"
DATABASE_TEST_URL="postgres://spot_dev_user:spot_dev_pw@db/spot_test"

# Be explicit about which Node runtime we're using for asset generation.
EXECJS_RUNTIME=Node

# Fedora config
# @see config/fedora.yml
FEDORA_URL=http://fedora:8080/rest
FEDORA_TEST_URL=http://fedora:8080/rest

# Using a servlet-ized FITS service keeps the load off the
# Sidekiq service + saves time by not booting Java on each call.
# To use the CLI application instead, comment out this line.
FITS_SERVLET_URL=http://fits-servlet:8080/fits

# Hyrax configuration values. Explicitly disabling Valkyrie
# until the migration work is complete.
HYRAX_DERIVATIVES_PATH=/spot/tmp/derivatives
HYRAX_VALKYRIE=false

# In production, this is a link to an Amazon Lambda service running
# Samvera's `serverless-iiif`, but in development this is an instance
# of Canatloupe that's configured to behave similarly.
IIIF_BASE_URL=http://localhost:8182/iiif/2

# Database configuration values
# @see config/database.yml
PSQL_HOST=db
PSQL_DATABASE=spot_dev
PSQL_PASSWORD=spot_dev_pw
PSQL_TEST_DATABASE=spot_test
PSQL_USER=spot_dev_user

# Rails configuration
RAILS_ENV=development
RAILS_LOG_TO_STDOUT="true"
RAILS_SERVE_STATIC_FILES="1"

# Redis configuration
# @see config/redis.yml
# @see config/initializers/redis_config.rb
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=""

# Rails uses this for encoding, but it's not really important in dev
SECRET_KEY_BASE=localshhh

# Solr configuration
# @see config/blacklight.yml
# @see config/solr.yml
SOLR_URL=http://solr:8983/solr/spot-development
SOLR_TEST_URL=http://solr:8983/solr/spot-test

# Spot uses this to generate URLs for works
URL_HOST=https://$APPLICATION_FQDN

# Valkyrie index configuration. Needs to be present
# even if Valkyrie isn't enabled.
# @see config/valkyrie_index.yml
VALKYRIE_SOLR_HOST=solr
VALKYRIE_SOLR_CORE=spot-development